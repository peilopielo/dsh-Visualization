{
  "name": "dsh-visualization",
  "version": "0.1.17",
  "description": "DSH Visualization — a session instrument: rings, turns, tools and background jobs of a live DeepSeek Harness session.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "fold.cjs",
    "build.cjs",
    "cordis.patch.yml",
    "web",
    "locale",
    "icon.svg",
    "LICENSE",
    "README.md",
    "FAQ.md",
    "GUIDE.md",
    "AGENTS.md",
    "screenshots.json",
    "wallpaper/live.html",
    "wallpaper/hybrid.html",
    "wallpaper/project.json",
    "wallpaper/preview.jpg",
    "wallpaper/lively",
    "wallpaper/lively-package.zip",
    "wallpaper/README.md",
    "README.en.md",
    "GUIDE.en.md",
    "AGENTS.en.md",
    "FAQ.en.md",
    "wallpaper/README.en.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "visualization",
    "session"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "scripts": {
    "build": "node build.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peilopielo/dsh-Visualization.git"
  },
  "homepage": "https://github.com/peilopielo/dsh-Visualization",
  "bugs": {
    "url": "https://github.com/peilopielo/dsh-Visualization/issues"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
